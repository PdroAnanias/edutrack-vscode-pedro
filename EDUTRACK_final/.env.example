# ============================================================================
# EduTrack AI v2 — Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env na raiz (ou nas pastas backend/ e analytics-service/)
# NUNCA comite arquivos .env reais contendo senhas ou segredos no Git.
# ============================================================================

# -------------------------------------------------------------
# 1. BANCO DE DADOS (Microsoft SQL Server)
# -------------------------------------------------------------
# Instância do SQL Server (Ex: localhost\SQLEXPRESS ou 127.0.0.1,1433)
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=EduTrackAI
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Usuário e senha para a aplicação Node.js (Leitura, Escrita e Execução)
DB_APP_USER=edutrack_app
DB_APP_PASSWORD=SuaSenhaForteApp123!
# Variável consumida diretamente pelo backend:
DB_USER=edutrack_app
DB_PASSWORD=SuaSenhaForteApp123!

# Usuário e senha para o microsserviço Python Analytics (Somente Leitura)
DB_PY_USER=edutrack_py_ro
DB_PY_PASSWORD=SuaSenhaFortePyRo123!

# -------------------------------------------------------------
# 2. BACKEND NODE.JS (Porta 3001)
# -------------------------------------------------------------
PORT=3001
# Chave secreta criptográfica para assinatura dos JWTs (mínimo de 32 caracteres)
JWT_SECRET=coloque_aqui_um_segredo_jwt_aleatorio_e_longo_com_32_chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
DB_POOL_MAX=20

# -------------------------------------------------------------
# 3. MICROSSERVIÇO ANALYTICS PYTHON (Porta 8000)
# -------------------------------------------------------------
ANALYTICS_URL=http://127.0.0.1:8000
# Chave secreta interna compartilhada entre Node.js e Python (X-Internal-Key)
ANALYTICS_INTERNAL_KEY=sua_chave_interna_secreta_compartilhada_aqui
INTERNAL_KEY=sua_chave_interna_secreta_compartilhada_aqui

# Integração opcional com Google Gemini para enriquecimento de insights
LLM_PROVIDER=gemini
LLM_API_KEY=sua_chave_da_api_google_gemini_aqui
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_INSIGHTS=6

# Fuso horário para consolidação de relatórios
TZ=America/Sao_Paulo
